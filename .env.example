# Required to query the retention database and use protected analytics APIs.
DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>

# Required for the configured OAuth provider. Keep credentials outside Git.
OAUTH_SERVER_URL=https://<oauth-provider>
VITE_OAUTH_PORTAL_URL=https://<oauth-provider>/authorize
VITE_APP_ID=<public-application-id>
JWT_SECRET=<long-random-server-secret>
OWNER_OPEN_ID=<owner-open-id>

# Optional runtime configuration.
NODE_ENV=development
PORT=3000
SERVICE_NAME=customer-retention-web
APP_URL=http://localhost:3000
LOG_LEVEL=info
DEMO_MODE=false
DEV_LOCAL_AUTH_ENABLED=false

# Required only for the grounded GenAI analyst.
BUILT_IN_FORGE_API_URL=https://<llm-provider>
BUILT_IN_FORGE_API_KEY=<server-side-provider-key>
ANALYST_MODEL=gpt-5-mini

# Optional frontend integrations.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

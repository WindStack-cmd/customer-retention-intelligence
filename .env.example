# Required to query the retention database and use protected analytics APIs.
DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>

# Required for the configured OAuth provider. Keep credentials outside Git.
OAUTH_SERVER_URL=https://<oauth-provider>
VITE_OAUTH_PORTAL_URL=https://<oauth-provider>/authorize
VITE_APP_ID=<public-application-id>
JWT_SECRET=<long-random-server-secret>
OWNER_OPEN_ID=<owner-open-id>

# Optional runtime configuration.
NODE_ENV=development
PORT=3000
SERVICE_NAME=customer-retention-web
APP_URL=http://localhost:3000
LOG_LEVEL=info
DEMO_MODE=false
DEV_LOCAL_AUTH_ENABLED=false

# Required only for the grounded GenAI analyst.
BUILT_IN_FORGE_API_URL=https://<llm-provider>
BUILT_IN_FORGE_API_KEY=<server-side-provider-key>
ANALYST_MODEL=gpt-5-mini

# Optional frontend integrations.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# SaaS Multi-Tenancy, Billing, Integrations, & Security
# External services fallback gracefully to labeled Mock Mode when credentials are empty.

# Stripe Billing & Subscriptions
# Required for live payment processing and customer portal sessions.
STRIPE_SECRET_KEY=sk_test_...
# Secret for verifying incoming Stripe webhook signatures (/api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=whsec_...

# E-commerce Connectors
# Admin API access token for Shopify store order and customer event ingestion.
SHOPIFY_API_KEY=shpat_...
# Shopify store domain (e.g. your-store.myshopify.com)
SHOPIFY_SHOP_DOMAIN=

# Retention Playbook Email Dispatch
# Primary email provider key for win-back playbooks (Resend).
RESEND_API_KEY=re_...
# Alternative email provider key (Twilio SendGrid fallback).
SENDGRID_API_KEY=SG....
# Verified outbound email address for customer retention outreach.
PLAYBOOK_FROM_EMAIL=retention@pulseboard.io

# CRM Integration & Task Alerts
# OAuth access token for HubSpot CRM automated tasks on at-risk accounts.
HUBSPOT_ACCESS_TOKEN=pat-na1-...
# OAuth access token for Salesforce CRM tasks.
SALESFORCE_ACCESS_TOKEN=
# Salesforce instance URL (defaults to https://login.salesforce.com).
SALESFORCE_INSTANCE_URL=https://login.salesforce.com

# Base Application URL (used for SAML SP Entity ID and ACS redirect resolution)
APP_BASE_URL=http://localhost:3000

# Security & Development Flags
# Explicit development-only authentication bypass flag. When true and NODE_ENV=development,
# automatically provisions a local admin session for testing without OAuth.
DEV_AUTH_BYPASS=false

# Local tenant storage cache path (used as fallback when MySQL database is offline in development).
TENANT_CACHE_FILE=data/tenants_cache.json
